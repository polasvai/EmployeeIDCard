# ==========================================
# Google Firebase Configuration (Database & Auth)
# ==========================================
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ==========================================
# Cloudflare R2 Picture Storage Configuration
# ==========================================
# URL to your deployed Cloudflare R2 Worker endpoint
VITE_CLOUDFLARE_WORKER_UPLOAD_URL=https://your-worker.your-subdomain.workers.dev/upload
# (Optional) Custom CDN domain or R2 public bucket URL (e.g. https://pub-xxx.r2.dev or https://cdn.idcard.bd)
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev
# (Optional) Upload Secret token matching your worker config
VITE_CLOUDFLARE_UPLOAD_SECRET=
